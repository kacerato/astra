<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike S-13: C# no aparelho (runtime oficial .NET para Android/bionic = Mono JIT). Mesmos laços do S-08. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeFrameworkVersion>8.0.27</RuntimeFrameworkVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compilação de scripts no aparelho (o que o editor faria ao salvar um .cs). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
</Project>
