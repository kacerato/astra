{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "host-windows",
      "displayName": "Host Windows (Vulkan, VS 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/host-windows",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "host-windows-vs2022",
      "displayName": "Host Windows (Vulkan, VS 2022; CI)",
      "inherits": "host-windows",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/host-windows-vs2022"
    },
    {
      "name": "android-arm64-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-29",
        "ANDROID_STL": "c++_static",
        "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "ON"
      }
    },
    {
      "name": "android-arm64-debug",
      "inherits": "android-arm64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "android-arm64-release",
      "inherits": "android-arm64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "host-windows-debug", "configurePreset": "host-windows", "configuration": "Debug" },
    { "name": "host-windows-release", "configurePreset": "host-windows", "configuration": "Release" },
    { "name": "host-windows-vs2022-release", "configurePreset": "host-windows-vs2022", "configuration": "Release" },
    { "name": "android-arm64-debug", "configurePreset": "android-arm64-debug" },
    { "name": "android-arm64-release", "configurePreset": "android-arm64-release" }
  ]
}
